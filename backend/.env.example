# ================================================
# KONFIGURASI SERVER & DATABASE (BACKEND)
# Salin file ini menjadi '.env' di folder backend/
# ================================================

# Port aplikasi (Otomatis diset oleh Vercel / Render / Railway)
PORT=5000

# ================================================
# PILIHAN 1: SUPABASE (DIREKOMENDASIKAN UNTUK VERCEL)
# Jika variabel ini diisi, backend otomatis menggunakan Supabase!
# ================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ================================================
# PILIHAN 2: MYSQL (UNTUK LOKAL XAMPP / VPS / CLOUD MYSQL)
# ================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=banjir_prediksi
DB_SSL=false

# Alternatif jika menggunakan connection string tunggal MySQL (opsional):
# DATABASE_URL=mysql://user:password@host:port/database
