# ================================================
# KONFIGURASI SERVER & DATABASE (BACKEND)
# Salin file ini menjadi '.env' di folder backend/
# ================================================

# Port aplikasi (Otomatis diset oleh cloud provider seperti Render/Railway)
PORT=5000

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=banjir_prediksi

# Set 'true' jika menggunakan Cloud MySQL dengan koneksi SSL (Aiven, TiDB Cloud, PlanetScale, dll)
DB_SSL=false

# Alternatif jika menggunakan connection string tunggal dari Cloud Provider (opsional):
# DATABASE_URL=mysql://user:password@host:port/database
